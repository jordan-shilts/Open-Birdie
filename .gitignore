# dependencies
node_modules/

# electron-builder output (installer + unpacked app; regenerates via npm run dist)
dist/

# downloaded course + terrain cache (regenerates on demand from open data)
data/courses/*.json
# course aerial photos / NDVI classmaps written beside the cache by the data tools
data/courses/*.jpg
data/courses/*.png
# bounded course cache index (sizes + last played)
data/course-cache.json
# cloud course service: local directory store (when S3_BUCKET is unset)
/cloud-store/
# this computer's cloud address and build token (a secret)
data/cloud.json
# the player's shot history (bag), what waits to go to Supabase, and the Supabase
# project address + publishable key
data/bag.json*
data/bag-outbox.json*
data/supabase.json

# HD compiler build workspace + generated hole bundles
# (regenerate from open 3DEP/NAIP data; too large for normal git history)
data/hd-build-cache/
data/hd-courses/

# validated generated runtime course-art tree (regenerate from courses/curated)
/build/course-art/

# throwaway render-capture sink + screenshots (dev verification only)
.shots/
# static HUD preview harness (WebGL-free, for screenshotting the HUD)
public/_hudmock.html
public/_bg.jpg

# logs / OS cruft
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.gstack/
/reference/
